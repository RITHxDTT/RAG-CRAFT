POSTGRES_DB=rag_craft
POSTGRES_USER=rag_craft
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://rag_craft:replace-with-local-password@localhost:55432/rag_craft
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_craft
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
JWT_SECRET=replace-with-at-least-32-random-characters
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3
MAX_CONTEXT_CHARS=16000
EMBEDDING_BATCH_SIZE=16
OLLAMA_TIMEOUT_SECONDS=180
QDRANT_TIMEOUT_SECONDS=30
MAX_EXTRACTED_CHARS=4000000
MAX_DOCUMENT_CHUNKS=10000
WORKER_POLL_SECONDS=2
MAX_UPLOAD_SIZE_MB=20
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth cookies: use true behind HTTPS; localhost development uses false.
COOKIE_SECURE=false
SESSION_MINUTES=480
FRONTEND_PORT=3000
# Optional: absolute document storage path (default: backend/storage)
# STORAGE_DIR=/absolute/path/to/storage

# Version 2: URLs used for public links, widgets, and Telegram webhooks.
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
# Telegram requires PUBLIC_API_URL to be reachable over HTTPS.
# Set a persistent Fernet key in your private .env before connecting Telegram.
# INTEGRATION_ENCRYPTION_KEY=

# Optional password-reset email delivery (leave unset until SMTP is configured).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_STARTTLS=true
