# Copy to .env.microservices and replace every secret. Never commit the copy.
# Used by: docker compose -f docker-compose.microservices.yml --env-file .env.microservices up --build

# Shared by every service. Must match the FastAPI JWT_SECRET if both backends run side by side (32+ chars).
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Service-to-service token for /api/internal/** calls.
INTERNAL_TOKEN=replace-with-another-long-random-string
# Encrypts Telegram bot tokens at rest in channel-service (32+ chars).
INTEGRATION_ENCRYPTION_KEY=replace-with-a-third-long-random-string

# One PostgreSQL container per service; all use this user and password.
DB_USER=ragcraft
DB_PASSWORD=replace-with-a-strong-database-password

# Browser-facing URLs.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
COOKIE_SECURE=false

# Demo accounts admin@gmail.com / user@gmail.com with password 123 (set false for a real deployment).
SEED_DEMO_ACCOUNTS=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
# log = print password reset tokens to the identity-service log instead of sending email.
MAIL_MODE=log

# mock = simulated ingestion and answers (no Qdrant or Ollama). external = FastAPI RAG service (later phase).
PROCESSING_MODE=mock
RAG_MODE=mock
RAG_SERVICE_URL=http://backend:8000
# simulated = no calls to api.telegram.org. live = register webhooks and send replies for real.
TELEGRAM_MODE=simulated
