# Copy to .env.craftrag and fill in the password. Never commit the copy (the .env.* rule in .gitignore already blocks it).
# Used by: services/scripts/run-craftrag.sh up
# Database: one database (craftrag_db) with one PostgreSQL schema per service (identity, catalog, chatbot, knowledge, channel ...).
CRAFTRAG_DB_HOST=192.168.64.9
CRAFTRAG_DB_PORT=5432
CRAFTRAG_DB_NAME=craftrag_db
CRAFTRAG_DB_USER=ragcraft_user
CRAFTRAG_DB_PASSWORD=

# Shared by every service. Use long random values anywhere beyond local development.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
INTERNAL_TOKEN=replace-with-another-long-random-string

# Browser origin(s) allowed to call the gateway.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GATEWAY_PORT=8080
# true creates admin@gmail.com / user@gmail.com (password 123) on first start. Turn off for a real deployment.
SEED_DEMO_ACCOUNTS=true
# false = new accounts must confirm an e-mailed link before signing in.
AUTO_VERIFY_EMAIL=true
